<Window x:Class="PalWorldServerManager.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pal Server Hub - Initial Setup"
        Width="760"
        Height="690"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        Foreground="#F8FAFC">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Initial Setup"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Connect Pal Server Hub to your Palworld Dedicated Server. You can change every option later."
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <Border Background="#CC111827"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="1. PalServer.exe"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Select the PalServer.exe that this manager should start."
                                   Foreground="#94A3B8"
                                   Margin="0,5,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ServerExecutablePathTextBox"
                                     MinHeight="38"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Width="105"
                                    Height="38"
                                    Click="BrowseServer_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#CC111827"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="2. PalWorldSettings.ini"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Select the active server settings file, normally under Pal\Saved\Config\WindowsServer."
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SettingsFilePathTextBox"
                                     MinHeight="38"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Width="105"
                                    Height="38"
                                    Click="BrowseSettings_Click"/>
                        </Grid>

                        <TextBlock Text="After setup, open Settings > Network to verify the REST API is enabled and the administrator password/REST API port are correct."
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#CC111827"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="3. Optional tools"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="SteamCMD is optional and is only needed for update-before-start."
                                   Foreground="#94A3B8"
                                   Margin="0,5,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SteamCmdPathTextBox"
                                     MinHeight="38"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Width="105"
                                    Height="38"
                                    Click="BrowseSteamCmd_Click"/>
                        </Grid>

                        <CheckBox x:Name="AttachToRunningServerCheckBox"
                                  Content="Attach to an already-running Palworld server when the app starts"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="CheckForUpdatesCheckBox"
                                  Content="Check for server updates before startup"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Start Pal Server Hub when Windows starts"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Tip: Help &amp; Guides includes Initial Setup, Discord webhook instructions, SteamCMD help, crash recovery, backups, and troubleshooting."
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Skip for now"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Left"
                    Click="Skip_Click"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Finish Setup"
                        Width="125"
                        Height="40"
                        Click="Finish_Click"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>
