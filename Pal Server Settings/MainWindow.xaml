<Window x:Class="PalWorldServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalWorld Server Manager"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1220"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#E6111827"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#D9172033"/>
        <SolidColorBrush x:Key="InputBackground" Color="#E61E293B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="MutedTextColor" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>

        <!-- Text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
        </Style>

        <!-- Text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Password boxes -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
        </Style>

        <!-- Checkboxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <!-- Combo boxes -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding"
                    Value="8"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Padding"
                    Value="8"/>
        </Style>

        <!-- Main buttons -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryColor}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="16,10"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
        </Style>

        <!-- Sidebar buttons -->
        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextColor}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

            <Setter Property="Margin"
                    Value="10,3"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#1E293B"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cards -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource PanelBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <!-- Version card -->
                <Border DockPanel.Dock="Bottom"
                        Background="#0F172A"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="15">

                    <StackPanel>

                        <TextBlock Text="PalWorld Server Manager"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Version 0.2 UI Preview"
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,20">

                    <TextBlock Text="PALWORLD"
                               Foreground="#60A5FA"
                               FontSize="13"
                               FontWeight="Bold"/>

                    <TextBlock Text="Server Manager"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Dedicated Server Tools"
                               Foreground="{StaticResource MutedTextColor}"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <!-- Navigation -->
                <StackPanel>

                    <Button Content="⌂   Dashboard"
                            Tag="0"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="⚙   Settings"
                            Tag="1"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="♟   Players"
                            Tag="2"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="▤   Console"
                            Tag="3"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="▣   Backups"
                            Tag="4"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="◷   Scheduler"
                            Tag="5"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="◆   Mods"
                            Tag="6"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1"
              Background="{StaticResource WindowBackground}">

            <!-- Scenic application background -->
            <Image Source="Assets/PalworldBackground.png"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"/>

            <!-- Dark overlay keeps text and controls readable -->
            <Border Background="#A80B1220"
                    IsHitTestVisible="False"/>

            <TabControl x:Name="MainNavigationTabControl"
                        SelectedIndex="0"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- Hide standard page tabs -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- DASHBOARD -->
                <TabItem>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="30">

                            <!-- Dashboard header -->
                            <Grid Margin="0,0,0,22">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Dashboard"
                                               FontSize="29"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Monitor and control the local Palworld dedicated server."
                                               Foreground="{StaticResource MutedTextColor}"
                                               Margin="0,6,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">

                                    <Button Content="Load Settings"
                                            Width="135"
                                            Height="42"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="LoadButton_Click"/>

                                    <Button Content="Open Settings"
                                            Width="135"
                                            Height="42"
                                            Tag="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="NavigationButton_Click"/>

                                </StackPanel>
                            </Grid>

                            <!-- Server runtime status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="ServerProcessStatusDot"
                                             Width="15"
                                             Height="15"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,14,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ServerProcessStatusTitle"
                                                   Text="Server status unknown"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="ServerProcessStatusDescription"
                                                   Text="Select PalServer.exe to begin monitoring and control."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ServerProcessIdText"
                                               Grid.Column="2"
                                               Text="PID: —"
                                               Foreground="{StaticResource MutedTextColor}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Runtime metric cards -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU Usage"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="ServerCpuUsageText"
                                                   Text="0.0%"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Memory Usage"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="ServerMemoryUsageText"
                                                   Text="0 MB"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Uptime"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="ServerUptimeText"
                                                   Text="00:00:00"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Server controls -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <StackPanel>
                                    <TextBlock Text="Server Controls"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Choose the PalServer launcher and configure the command-line arguments used when starting it."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,18"/>

                                    <TextBlock Text="PalServer executable"/>

                                    <Grid Margin="0,6,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="ServerExecutablePathTextBox"
                                                 IsReadOnly="True"
                                                 Margin="0,0,10,0"/>

                                        <Button x:Name="BrowseServerExecutableButton"
                                                Grid.Column="1"
                                                Content="Browse..."
                                                Width="110"
                                                Height="38"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <TextBlock Text="Launch arguments"/>

                                    <TextBox x:Name="ServerLaunchArgumentsTextBox"
                                             Margin="0,6,0,16"/>

                                    <CheckBox x:Name="AttachToRunningServerCheckBox"
                                              Content="Attach to an already-running Palworld server when the app starts"
                                              Margin="0,0,0,18"/>

                                    <WrapPanel>
                                        <Button x:Name="StartServerButton"
                                                Content="Start Server"
                                                Width="130"
                                                Height="42"
                                                Margin="0,0,10,10"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="StopServerButton"
                                                Content="Stop Server"
                                                Width="130"
                                                Height="42"
                                                Margin="0,0,10,10"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="RestartServerButton"
                                                Content="Restart Server"
                                                Width="135"
                                                Height="42"
                                                Margin="0,0,10,10"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="ForceStopServerButton"
                                                Content="Force Stop"
                                                Width="125"
                                                Height="42"
                                                Margin="0,0,10,10"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="SaveServerPreferencesButton"
                                                Content="Save Preferences"
                                                Width="145"
                                                Height="42"
                                                Margin="0,0,10,10"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Loaded configuration status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="DashboardStatusDot"
                                             Width="14"
                                             Height="14"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,14,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="DashboardStatusTitle"
                                                   Text="No settings file loaded"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="DashboardStatusDescription"
                                                   Text="Click Load Settings and select PalWorldSettings.ini."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Configuration metrics row 1 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Server Name"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardServerNameText"
                                                   Text="Not loaded"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Maximum Players"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardPlayerLimitText"
                                                   Text="—"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="XP Rate"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardExpRateText"
                                                   Text="—"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Configuration metrics row 2 -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Game Mode"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardGameModeText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="PvP"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardPvpText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Hardcore"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardHardcoreText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Public Port"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardPortText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>

                    </ScrollViewer>
                </TabItem>

                <!-- SETTINGS -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Settings header -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Server Settings"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Load, edit, validate, and save PalWorldSettings.ini."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button Content="Load Settings"
                                        Width="135"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LoadButton_Click"/>

                                <Button x:Name="SaveButton"
                                        Content="Save Settings"
                                        Width="135"
                                        Height="40"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveButton_Click"/>

                            </StackPanel>
                        </Grid>

                        <!-- Settings tabs -->
                        <TabControl Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderColor}">

                            <!-- Server tab -->
                            <TabItem Header="Server">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Server Information"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Server Name"/>

                                            <TextBox x:Name="ServerNameTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Server Description"/>

                                            <TextBox x:Name="DescriptionTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Players"/>

                                            <TextBox x:Name="MaxPlayersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Admin Password"/>

                                            <PasswordBox x:Name="AdminPasswordBox"
                                                         Margin="0,6,0,16"/>

                                            <TextBlock Text="Server Password"/>

                                            <PasswordBox x:Name="ServerPasswordBox"
                                                         Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Gameplay tab -->
                            <TabItem Header="Gameplay">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Gameplay Rates"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="XP Rate"/>

                                            <TextBox x:Name="ExpRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Pal Capture Rate"/>

                                            <TextBox x:Name="PalCaptureRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Pal Spawn Rate"/>

                                            <TextBox x:Name="PalSpawnRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Daytime Speed Rate"/>

                                            <TextBox x:Name="DayTimeSpeedTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Nighttime Speed Rate"/>

                                            <TextBox x:Name="NightTimeSpeedTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Work Speed Rate"/>

                                            <TextBox x:Name="WorkSpeedTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- PvP tab -->
                            <TabItem Header="PvP &amp; Hardcore">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="PvP and Hardcore"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <CheckBox x:Name="PvpCheckBox"
                                                      Content="Enable PvP"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="HardcoreCheckBox"
                                                      Content="Enable Hardcore Mode"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="FriendlyFireCheckBox"
                                                      Content="Enable Friendly Fire"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="CharacterRecreateCheckBox"
                                                      Content="Allow Character Recreation in Hardcore"
                                                      Margin="0,5,0,18"/>

                                            <TextBlock Text="Death Penalty"/>

                                            <ComboBox x:Name="DeathPenaltyComboBox"
                                                      IsEditable="True"
                                                      Margin="0,6,0,0">

                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Item"/>
                                                <ComboBoxItem Content="ItemAndEquipment"/>
                                                <ComboBoxItem Content="All"/>

                                            </ComboBox>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Bases tab -->
                            <TabItem Header="Bases &amp; Guilds">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Bases and Guilds"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Workers Per Base"/>

                                            <TextBox x:Name="BaseWorkersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Guild Players"/>

                                            <TextBox x:Name="GuildPlayersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Bases Per Guild"/>

                                            <TextBox x:Name="BasesPerGuildTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Total Base Camps"/>

                                            <TextBox x:Name="BaseCampMaxTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Network tab -->
                            <TabItem Header="Network">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Network Settings"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Public IP Address"/>

                                            <TextBox x:Name="PublicIpTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Public Port"/>

                                            <TextBox x:Name="PublicPortTextBox"
                                                     Margin="0,6,0,16"/>

                                            <CheckBox x:Name="RconEnabledCheckBox"
                                                      Content="Enable RCON"
                                                      Margin="0,5,0,16"/>

                                            <TextBlock Text="RCON Port"/>

                                            <TextBox x:Name="RconPortTextBox"
                                                     Margin="0,6,0,16"/>

                                            <CheckBox x:Name="RestApiEnabledCheckBox"
                                                      Content="Enable REST API"
                                                      Margin="0,5,0,16"/>

                                            <TextBlock Text="REST API Port"/>

                                            <TextBox x:Name="RestApiPortTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Advanced tab -->
                            <TabItem Header="Advanced">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Advanced Settings"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <CheckBox x:Name="UseAuthCheckBox"
                                                      Content="Require Authentication"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="AllowClientModCheckBox"
                                                      Content="Allow Client Mods"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="BackupSaveDataCheckBox"
                                                      Content="Use Backup Save Data"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="ShowPlayerListCheckBox"
                                                      Content="Show Player List"
                                                      Margin="0,5,0,18"/>

                                            <TextBlock Text="Maximum Chat Posts Per Minute"/>

                                            <TextBox x:Name="ChatPostLimitTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                        </TabControl>

                        <!-- Status bar -->
                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10"
                                Margin="0,15,0,0">

                            <TextBlock x:Name="StatusTextBlock"
                                       Text="No settings file loaded."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </Grid>
                </TabItem>

                <!-- PLAYERS -->
                <TabItem>

                    <Grid Margin="28">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="520">

                            <TextBlock Text="Players"
                                       FontSize="29"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Live player information will require the Palworld REST API or RCON connection."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Grid>
                </TabItem>

                <!-- CONSOLE -->
                <TabItem>

                    <Grid Margin="28">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="520">

                            <TextBlock Text="Console"
                                       FontSize="29"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="A live console and server logs will be added after server process controls are implemented."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Grid>
                </TabItem>

                <!-- BACKUPS -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Backups header -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Backups"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Review, restore, and delete configuration backups for the loaded settings file."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button x:Name="RefreshBackupsButton"
                                        Content="Refresh"
                                        Width="110"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button x:Name="OpenBackupFolderButton"
                                        Content="Open Folder"
                                        Width="125"
                                        Height="40"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                            </StackPanel>

                        </Grid>

                        <!-- Backup status -->
                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="BackupStatusDot"
                                         Width="14"
                                         Height="14"
                                         Fill="{StaticResource WarningColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1">

                                    <TextBlock x:Name="BackupStatusTitleText"
                                               Text="No settings file loaded"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="BackupStatusDescriptionText"
                                               Text="Load PalWorldSettings.ini before viewing backups."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- Backup list -->
                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}">

                            <Grid>

                                <ListView x:Name="BackupListView"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{StaticResource TextColor}"
                                          HorizontalContentAlignment="Stretch">

                                    <ListView.View>
                                        <GridView>

                                            <GridViewColumn Header="Created"
                                                            Width="190"
                                                            DisplayMemberBinding="{Binding CreatedAtDisplay}"/>

                                            <GridViewColumn Header="File Name"
                                                            Width="430"
                                                            DisplayMemberBinding="{Binding FileName}"/>

                                            <GridViewColumn Header="Size"
                                                            Width="110"
                                                            DisplayMemberBinding="{Binding SizeDisplay}"/>

                                        </GridView>
                                    </ListView.View>

                                </ListView>

                                <StackPanel x:Name="NoBackupsPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="520">

                                    <TextBlock Text="No backups found"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="NoBackupsText"
                                               Text="Save the settings file to create your first timestamped backup."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- Backup actions -->
                        <Grid Grid.Row="3"
                              Margin="0,18,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Restoring creates a safety backup of the current file first."
                                       Foreground="{StaticResource MutedTextColor}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button x:Name="DeleteBackupButton"
                                        Content="Delete Selected"
                                        Width="145"
                                        Height="42"
                                        Margin="0,0,10,0"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button x:Name="RestoreBackupButton"
                                        Content="Restore Selected"
                                        Width="155"
                                        Height="42"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                            </StackPanel>

                        </Grid>

                    </Grid>
                </TabItem>

                <!-- SCHEDULER -->
                <TabItem>

                    <Grid Margin="28">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="520">

                            <TextBlock Text="Scheduler"
                                       FontSize="29"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Scheduled restarts, saves, and backups will be added in a later phase."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Grid>
                </TabItem>

                <!-- MODS -->
                <TabItem>

                    <Grid Margin="28">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="520">

                            <TextBlock Text="Mods"
                                       FontSize="29"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Mod management is planned for a future release."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Grid>
                </TabItem>

            </TabControl>

        </Grid>

    </Grid>

</Window>