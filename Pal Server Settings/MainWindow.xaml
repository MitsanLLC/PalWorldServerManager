<Window x:Class="PalWorldServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalWorld Server Manager"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1220"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#E6111827"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#D9172033"/>
        <SolidColorBrush x:Key="InputBackground" Color="#E61E293B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="MutedTextColor" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>

        <!-- Text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
        </Style>

        <!-- Text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Password boxes -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
        </Style>

        <!-- Checkboxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <!-- Combo boxes -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding"
                    Value="8"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"
                    Value="#111827"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Padding"
                    Value="8"/>
        </Style>

        <!-- Main buttons -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryColor}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="16,10"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
        </Style>

        <!-- Sidebar buttons -->
        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextColor}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

            <Setter Property="Margin"
                    Value="10,3"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#1E293B"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cards -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource PanelBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <!-- Version card -->
                <Border DockPanel.Dock="Bottom"
                        Background="#0F172A"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="15">

                    <StackPanel>

                        <TextBlock Text="PalWorld Server Manager"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Version 0.2 UI Preview"
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,20">

                    <TextBlock Text="PALWORLD"
                               Foreground="#60A5FA"
                               FontSize="13"
                               FontWeight="Bold"/>

                    <TextBlock Text="Server Manager"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Dedicated Server Tools"
                               Foreground="{StaticResource MutedTextColor}"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <!-- Navigation -->
                <StackPanel>

                    <Button Content="⌂   Dashboard"
                            Tag="0"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="⚙   Settings"
                            Tag="1"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="♟   Players"
                            Tag="2"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="▤   Console"
                            Tag="3"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="▣   Backups"
                            Tag="4"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="◷   Scheduler"
                            Tag="5"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="◆   Mods"
                            Tag="6"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1"
              Background="{StaticResource WindowBackground}">

            <!-- Scenic application background -->
            <Image Source="Assets/PalworldBackground.png"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False"/>

            <!-- Dark overlay keeps text and controls readable -->
            <Border Background="#A80B1220"
                    IsHitTestVisible="False"/>

            <TabControl x:Name="MainNavigationTabControl"
                        SelectedIndex="0"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- Hide standard page tabs -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- DASHBOARD -->
                <TabItem>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="30">

                            <!-- Dashboard header -->
                            <Grid Margin="0,0,0,22">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Dashboard"
                                               FontSize="29"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Monitor and control the local Palworld dedicated server."
                                               Foreground="{StaticResource MutedTextColor}"
                                               Margin="0,6,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">

                                    <Button Content="Load Settings"
                                            Width="135"
                                            Height="42"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="LoadButton_Click"/>

                                    <Button Content="Open Settings"
                                            Width="135"
                                            Height="42"
                                            Tag="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="NavigationButton_Click"/>

                                </StackPanel>
                            </Grid>

                            <!-- Server runtime status and primary controls -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="ServerProcessStatusDot"
                                             Width="15"
                                             Height="15"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,14,0"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock x:Name="ServerProcessStatusTitle"
                                                   Text="Server status unknown"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"/>

                                        <WrapPanel Margin="0,5,0,0">

                                            <TextBlock x:Name="ServerProcessStatusDescription"
                                                       Text="Select PalServer.exe to begin monitoring and control."
                                                       Foreground="{StaticResource MutedTextColor}"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="   •   "
                                                       Foreground="{StaticResource MutedTextColor}"/>

                                            <TextBlock x:Name="ServerProcessIdText"
                                                       Text="PID: —"
                                                       Foreground="{StaticResource MutedTextColor}"/>

                                        </WrapPanel>

                                    </StackPanel>

                                    <WrapPanel Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0">

                                        <Button x:Name="StartServerButton"
                                                Content="Start Server"
                                                Width="108"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="StopServerButton"
                                                Content="Stop Server"
                                                Width="108"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="RestartServerButton"
                                                Content="Restart"
                                                Width="95"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="ForceStopServerButton"
                                                Content="Force Stop"
                                                Width="100"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="SaveWorldButton"
                                                Content="Save World"
                                                Width="105"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                IsEnabled="False"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="SaveServerPreferencesButton"
                                                Content="Save Preferences"
                                                Width="130"
                                                Height="38"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </WrapPanel>

                                    <TextBlock x:Name="LastWorldSaveText"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Text="Last World Save: —"
                                               Foreground="{StaticResource MutedTextColor}"
                                               FontSize="12"
                                               Margin="0,8,0,0"/>

                                </Grid>
                            </Border>



                            <!-- Server health and live metrics -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <StackPanel>

                                    <Grid Margin="0,0,0,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse x:Name="ServerHealthStatusDot"
                                                 Width="14"
                                                 Height="14"
                                                 Fill="{StaticResource MutedTextColor}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock x:Name="ServerHealthStatusTitle"
                                                       Text="Server Health: Unknown"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock x:Name="ServerHealthStatusDescription"
                                                       Text="Health monitoring will begin when PalServer is running."
                                                       Foreground="{StaticResource MutedTextColor}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock x:Name="LiveMetricsStatusText"
                                                       Text="Metrics unavailable until the server is running and REST API is connected."
                                                       Foreground="{StaticResource MutedTextColor}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="20,0,0,0">

                                            <StackPanel Margin="0,0,20,0">

                                                <TextBlock Text="LAST WARNING"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock x:Name="LastHealthWarningText"
                                                           Text="—"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>

                                            <StackPanel Margin="0,0,18,0">

                                                <TextBlock Text="LAST CRASH"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock x:Name="LastCrashText"
                                                           Text="—"
                                                           FontSize="13"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>

                                            <Button x:Name="RefreshMetricsButton"
                                                    Content="Refresh"
                                                    Width="95"
                                                    Height="38"
                                                    Style="{StaticResource SecondaryButtonStyle}"/>

                                        </StackPanel>

                                    </Grid>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#99111827"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Players"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="12"/>
                                                <TextBlock x:Name="LivePlayersText"
                                                           Text="—"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="#99111827"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Server FPS"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="12"/>
                                                <TextBlock x:Name="LiveServerFpsText"
                                                           Text="—"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#99111827"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="CPU"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="12"/>
                                                <TextBlock x:Name="HealthCpuText"
                                                           Text="—"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3"
                                                Background="#99111827"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Memory"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="12"/>
                                                <TextBlock x:Name="HealthMemoryText"
                                                           Text="—"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4"
                                                Background="#99111827"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="World Uptime"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="12"/>
                                                <TextBlock x:Name="LiveWorldUptimeText"
                                                           Text="—"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="5"
                                                Background="#99111827"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Day / Bases"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="12"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,7,0,0">
                                                    <TextBlock x:Name="LiveWorldDayText"
                                                               Text="—"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text=" / "
                                                               Foreground="{StaticResource MutedTextColor}"
                                                               FontSize="18"/>
                                                    <TextBlock x:Name="LiveBaseCountText"
                                                               Text="—"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                    </Grid>

                                </StackPanel>

                            </Border>

                            <!-- Configuration metrics row 1 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Server Name"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardServerNameText"
                                                   Text="Not loaded"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Maximum Players"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardPlayerLimitText"
                                                   Text="—"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="XP Rate"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardExpRateText"
                                                   Text="—"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Configuration metrics row 2 -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Game Mode"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardGameModeText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="PvP"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardPvpText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Hardcore"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardHardcoreText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Public Port"
                                                   Foreground="{StaticResource MutedTextColor}"/>
                                        <TextBlock x:Name="DashboardPortText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Loaded configuration status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="DashboardStatusDot"
                                             Width="14"
                                             Height="14"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,14,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="DashboardStatusTitle"
                                                   Text="No settings file loaded"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="DashboardStatusDescription"
                                                   Text="Click Load Settings and select PalWorldSettings.ini."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Server controls -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <StackPanel>
                                    <TextBlock Text="Server Controls"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Choose the PalServer launcher and configure the command-line arguments used when starting it."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,18"/>

                                    <TextBlock Text="PalServer executable"/>

                                    <Grid Margin="0,6,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="ServerExecutablePathTextBox"
                                                 IsReadOnly="True"
                                                 Margin="0,0,10,0"/>

                                        <Button x:Name="BrowseServerExecutableButton"
                                                Grid.Column="1"
                                                Content="Browse..."
                                                Width="110"
                                                Height="38"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>

                                    <TextBlock Text="Launch arguments"/>

                                    <TextBox x:Name="ServerLaunchArgumentsTextBox"
                                             Margin="0,6,0,16"/>

                                    <CheckBox x:Name="AttachToRunningServerCheckBox"
                                              Content="Attach to an already-running Palworld server when the app starts"
                                              Margin="0,0,0,18"/>


                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </ScrollViewer>
                </TabItem>

                <!-- SETTINGS -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Settings header -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Server Settings"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Load, edit, validate, and save PalWorldSettings.ini."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button Content="Load Settings"
                                        Width="135"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LoadButton_Click"/>

                                <Button x:Name="SaveButton"
                                        Content="Save Settings"
                                        Width="135"
                                        Height="40"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveButton_Click"/>

                            </StackPanel>
                        </Grid>

                        <!-- Settings tabs -->
                        <TabControl Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderColor}">

                            <!-- Server tab -->
                            <TabItem Header="Server">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Server Information"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Server Name"/>

                                            <TextBox x:Name="ServerNameTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Server Description"/>

                                            <TextBox x:Name="DescriptionTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Players"/>

                                            <TextBox x:Name="MaxPlayersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Admin Password"/>

                                            <PasswordBox x:Name="AdminPasswordBox"
                                                         Margin="0,6,0,16"/>

                                            <TextBlock Text="Server Password"/>

                                            <PasswordBox x:Name="ServerPasswordBox"
                                                         Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Gameplay tab -->
                            <TabItem Header="Gameplay">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Gameplay Rates"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="XP Rate"/>

                                            <TextBox x:Name="ExpRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Pal Capture Rate"/>

                                            <TextBox x:Name="PalCaptureRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Pal Spawn Rate"/>

                                            <TextBox x:Name="PalSpawnRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Daytime Speed Rate"/>

                                            <TextBox x:Name="DayTimeSpeedTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Nighttime Speed Rate"/>

                                            <TextBox x:Name="NightTimeSpeedTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Work Speed Rate"/>

                                            <TextBox x:Name="WorkSpeedTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- PvP tab -->
                            <TabItem Header="PvP &amp; Hardcore">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="PvP and Hardcore"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <CheckBox x:Name="PvpCheckBox"
                                                      Content="Enable PvP"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="HardcoreCheckBox"
                                                      Content="Enable Hardcore Mode"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="FriendlyFireCheckBox"
                                                      Content="Enable Friendly Fire"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="CharacterRecreateCheckBox"
                                                      Content="Allow Character Recreation in Hardcore"
                                                      Margin="0,5,0,18"/>

                                            <TextBlock Text="Death Penalty"/>

                                            <ComboBox x:Name="DeathPenaltyComboBox"
                                                      IsEditable="True"
                                                      Margin="0,6,0,0">

                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Item"/>
                                                <ComboBoxItem Content="ItemAndEquipment"/>
                                                <ComboBoxItem Content="All"/>

                                            </ComboBox>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Bases tab -->
                            <TabItem Header="Bases &amp; Guilds">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Bases and Guilds"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Workers Per Base"/>

                                            <TextBox x:Name="BaseWorkersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Guild Players"/>

                                            <TextBox x:Name="GuildPlayersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Bases Per Guild"/>

                                            <TextBox x:Name="BasesPerGuildTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Total Base Camps"/>

                                            <TextBox x:Name="BaseCampMaxTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Network tab -->
                            <TabItem Header="Network">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Network Settings"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Public IP Address"/>

                                            <TextBox x:Name="PublicIpTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Public Port"/>

                                            <TextBox x:Name="PublicPortTextBox"
                                                     Margin="0,6,0,16"/>

                                            <CheckBox x:Name="RconEnabledCheckBox"
                                                      Content="Enable RCON"
                                                      Margin="0,5,0,16"/>

                                            <TextBlock Text="RCON Port"/>

                                            <TextBox x:Name="RconPortTextBox"
                                                     Margin="0,6,0,16"/>

                                            <CheckBox x:Name="RestApiEnabledCheckBox"
                                                      Content="Enable REST API"
                                                      Margin="0,5,0,16"/>

                                            <TextBlock Text="REST API Port"/>

                                            <TextBox x:Name="RestApiPortTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Advanced tab -->


                            <!-- Recovery tab -->
                            <TabItem Header="Recovery">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock Text="Automatic Crash Recovery"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Text="Automatically restart PalServer after an unexpected crash. Intentional stops and scheduled restarts do not trigger recovery."
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,18"/>

                                                <CheckBox x:Name="EnableCrashRecoveryCheckBox"
                                                          Content="Enable automatic crash recovery"
                                                          Margin="0,0,0,18"/>

                                                <WrapPanel>

                                                    <StackPanel Margin="0,0,28,0">

                                                        <TextBlock Text="Restart Delay"
                                                                   Margin="0,0,0,6"/>

                                                        <ComboBox x:Name="CrashRecoveryDelayComboBox"
                                                                  Width="160"
                                                                  SelectedIndex="1">

                                                            <ComboBoxItem Content="10 seconds"
                                                                          Tag="10"/>

                                                            <ComboBoxItem Content="30 seconds"
                                                                          Tag="30"/>

                                                            <ComboBoxItem Content="60 seconds"
                                                                          Tag="60"/>

                                                        </ComboBox>

                                                    </StackPanel>

                                                    <StackPanel>

                                                        <TextBlock Text="Maximum Attempts"
                                                                   Margin="0,0,0,6"/>

                                                        <ComboBox x:Name="CrashRecoveryMaxAttemptsComboBox"
                                                                  Width="160"
                                                                  SelectedIndex="1">

                                                            <ComboBoxItem Content="1 attempt"
                                                                          Tag="1"/>

                                                            <ComboBoxItem Content="3 attempts"
                                                                          Tag="3"/>

                                                            <ComboBoxItem Content="5 attempts"
                                                                          Tag="5"/>

                                                        </ComboBox>

                                                    </StackPanel>

                                                </WrapPanel>

                                                <TextBlock x:Name="CrashRecoveryStatusText"
                                                           Text="Crash recovery is disabled."
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,18,0,0"/>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="35,0,0,0"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="CRASH COUNT"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock x:Name="CrashCountText"
                                                           Text="0"
                                                           FontSize="26"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,18"/>

                                                <TextBlock Text="LAST RECOVERY"
                                                           Foreground="{StaticResource MutedTextColor}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock x:Name="LastRecoveryText"
                                                           Text="—"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                            <!-- Advanced tab -->
                            <TabItem Header="Advanced">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Advanced Settings"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <CheckBox x:Name="UseAuthCheckBox"
                                                      Content="Require Authentication"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="AllowClientModCheckBox"
                                                      Content="Allow Client Mods"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="BackupSaveDataCheckBox"
                                                      Content="Use Backup Save Data"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="ShowPlayerListCheckBox"
                                                      Content="Show Player List"
                                                      Margin="0,5,0,18"/>

                                            <TextBlock Text="Maximum Chat Posts Per Minute"/>

                                            <TextBox x:Name="ChatPostLimitTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </ScrollViewer>
                            </TabItem>

                        </TabControl>

                        <!-- Status bar -->
                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10"
                                Margin="0,15,0,0">

                            <TextBlock x:Name="StatusTextBlock"
                                       Text="No settings file loaded."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </Grid>
                </TabItem>

                <!-- PLAYERS -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Players header -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Players"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="View players currently connected to the Palworld server."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <Button x:Name="RefreshPlayersButton"
                                    Grid.Column="1"
                                    Content="Refresh Players"
                                    Width="145"
                                    Height="40"
                                    Style="{StaticResource PrimaryButtonStyle}"/>

                        </Grid>

                        <!-- Players status -->
                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="PlayersStatusDot"
                                         Width="12"
                                         Height="12"
                                         Fill="{StaticResource WarningColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1">

                                    <TextBlock x:Name="PlayersStatusTitle"
                                               Text="Players not loaded"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="PlayersStatusDescription"
                                               Text="Start the server and load PalWorldSettings.ini to view connected players."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="ONLINE"
                                               Foreground="{StaticResource MutedTextColor}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock x:Name="PlayersOnlineCountText"
                                               Text="—"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- Player list -->
                        <Border Grid.Row="2"
                                Background="#CC08111F"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">

                            <Grid>

                                <ListView x:Name="PlayersListView"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{StaticResource TextColor}"
                                          HorizontalContentAlignment="Stretch">

                                    <ListView.View>
                                        <GridView>

                                            <GridViewColumn Header="Player"
                                                            Width="170"
                                                            DisplayMemberBinding="{Binding Name}"/>

                                            <GridViewColumn Header="Account"
                                                            Width="155"
                                                            DisplayMemberBinding="{Binding AccountName}"/>

                                            <GridViewColumn Header="Level"
                                                            Width="70"
                                                            DisplayMemberBinding="{Binding Level}"/>

                                            <GridViewColumn Header="Ping"
                                                            Width="80"
                                                            DisplayMemberBinding="{Binding PingDisplay}"/>

                                            <GridViewColumn Header="User ID"
                                                            Width="210"
                                                            DisplayMemberBinding="{Binding UserId}"/>

                                            <GridViewColumn Header="Player ID"
                                                            Width="260"
                                                            DisplayMemberBinding="{Binding PlayerId}"/>

                                        </GridView>
                                    </ListView.View>

                                </ListView>

                                <StackPanel x:Name="NoPlayersPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Visible">

                                    <TextBlock Text="No players online"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="NoPlayersText"
                                               Text="Refresh the player list after someone joins the server."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="420"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- Player administration -->
                        <Border Grid.Row="3"
                                Style="{StaticResource CardStyle}"
                                Margin="0,14,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Player Administration"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="SelectedPlayerText"
                                               Text="Select a player above to enable administration controls."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Button x:Name="KickPlayerButton"
                                            Content="Kick Player"
                                            Width="120"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            IsEnabled="False"
                                            Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button x:Name="BanPlayerButton"
                                            Content="Ban Player"
                                            Width="120"
                                            Height="40"
                                            IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- Unban player -->
                        <Border Grid.Row="4"
                                Style="{StaticResource CardStyle}"
                                Margin="0,14,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Unban Player"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Enter the banned player's User ID, for example steam_00000000000000000."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10"/>

                                    <TextBox x:Name="UnbanUserIdTextBox"
                                             MinHeight="40"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Enter the banned player's User ID"/>

                                </StackPanel>

                                <Button x:Name="UnbanPlayerButton"
                                        Grid.Column="1"
                                        Content="Unban Player"
                                        Width="125"
                                        Height="40"
                                        Margin="14,34,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>

                <!-- CONSOLE -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Console header -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Console"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Activity from PalWorld Server Manager."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <CheckBox x:Name="ConsoleAutoScrollCheckBox"
                                          Content="Auto-scroll"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,18,0"/>

                                <Button x:Name="ClearConsoleButton"
                                        Content="Clear Console"
                                        Width="130"
                                        Height="40"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                            </StackPanel>

                        </Grid>

                        <!-- Console status -->
                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="12"
                                         Height="12"
                                         Fill="{StaticResource SuccessColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="Activity logging enabled"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Server controls, settings, backups, and REST API actions are recorded here."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- Announcement composer -->
                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Server Announcement"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Send a message to all connected players through the Palworld REST API."
                                               Foreground="{StaticResource MutedTextColor}"
                                               Margin="0,4,0,10"/>

                                    <TextBox x:Name="AnnouncementTextBox"
                                             MinHeight="40"
                                             MaxLength="250"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Enter a message to send to all players"/>

                                </StackPanel>

                                <Button x:Name="SendAnnouncementButton"
                                        Grid.Column="1"
                                        Content="Send"
                                        Width="110"
                                        Height="40"
                                        Margin="14,34,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                            </Grid>

                        </Border>

                        <!-- Activity log -->
                        <Border Grid.Row="3"
                                Background="#CC08111F"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">

                            <ListBox x:Name="ConsoleListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextColor}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource TextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="6,3"/>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Border>

                        <Border Grid.Row="4"
                                Style="{StaticResource CardStyle}"
                                Margin="0,10,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Admin Command"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <TextBox x:Name="ConsoleCommandTextBox"
                                             Margin="0,8,0,0"
                                             MinHeight="40"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Commands: save, announce &lt;message&gt;, players, restart, stop, clear"/>

                                    <TextBlock Text="Commands: save • announce &lt;message&gt; • players • restart • stop • clear"
                                               Foreground="{StaticResource MutedTextColor}"
                                               FontSize="12"
                                               Margin="0,7,0,0"/>

                                </StackPanel>

                                <Button x:Name="RunConsoleCommandButton"
                                        Grid.Column="1"
                                        Content="Run Command"
                                        Width="125"
                                        Height="40"
                                        Margin="14,29,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                            </Grid>

                        </Border>

                    </Grid>

                </TabItem>

                <!-- BACKUPS -->
                <TabItem>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="28">

                            <TextBlock Text="Backups"
                                       FontSize="29"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Manage both configuration backups and complete Palworld world-save backups."
                                       Foreground="{StaticResource MutedTextColor}"
                                       Margin="0,6,0,18"/>

                            <!-- WORLD SAVE BACKUPS -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="World Save Backups"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="WorldBackupStatusText"
                                                   Text="Load the active PalWorldSettings.ini to manage full world backups."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <WrapPanel Grid.Column="1"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center">

                                        <Button x:Name="BackupWorldNowButton"
                                                Content="Backup World Now"
                                                Width="145"
                                                Height="40"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="RefreshWorldBackupsButton"
                                                Content="Refresh"
                                                Width="95"
                                                Height="40"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="OpenWorldSaveFolderButton"
                                                Content="Open Save Folder"
                                                Width="135"
                                                Height="40"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="OpenWorldBackupFolderButton"
                                                Content="Open Backup Folder"
                                                Width="145"
                                                Height="40"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </WrapPanel>

                                </Grid>

                            </Border>

                            <Border Background="#CC08111F"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    MinHeight="230"
                                    Margin="0,0,0,14">

                                <Grid>

                                    <ListView x:Name="WorldBackupListView"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="{StaticResource TextColor}"
                                              HorizontalContentAlignment="Stretch">

                                        <ListView.View>
                                            <GridView>

                                                <GridViewColumn Header="Created"
                                                                Width="210"
                                                                DisplayMemberBinding="{Binding CreatedAtDisplay}"/>

                                                <GridViewColumn Header="Backup File"
                                                                Width="460"
                                                                DisplayMemberBinding="{Binding FileName}"/>

                                                <GridViewColumn Header="Size"
                                                                Width="120"
                                                                DisplayMemberBinding="{Binding SizeDisplay}"/>

                                            </GridView>
                                        </ListView.View>

                                    </ListView>

                                    <StackPanel x:Name="NoWorldBackupsPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="No world backups found"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="NoWorldBackupsText"
                                                   Text="Click Backup World Now to create the first full save-data backup."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="500"
                                                   Margin="0,8,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,24">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="SelectedWorldBackupText"
                                               Text="Select a world backup to restore or delete."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Margin="20,0,0,0">

                                        <Button x:Name="RestoreWorldBackupButton"
                                                Content="Restore Selected"
                                                Width="145"
                                                Height="40"
                                                Margin="0,0,10,0"
                                                IsEnabled="False"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="DeleteWorldBackupButton"
                                                Content="Delete Selected"
                                                Width="145"
                                                Height="40"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- CONFIGURATION BACKUPS -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="BackupStatusDot"
                                             Width="12"
                                             Height="12"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Configuration Backups"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="BackupStatusTitleText"
                                                   Text="No settings file loaded"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,0"/>

                                        <TextBlock x:Name="BackupStatusDescriptionText"
                                                   Text="Load PalWorldSettings.ini before viewing configuration backups."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">

                                        <Button x:Name="RefreshBackupsButton"
                                                Content="Refresh"
                                                Width="95"
                                                Height="40"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                        <Button x:Name="OpenBackupFolderButton"
                                                Content="Open Folder"
                                                Width="115"
                                                Height="40"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <Border Background="#CC08111F"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    MinHeight="220">

                                <Grid>

                                    <ListView x:Name="BackupListView"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="{StaticResource TextColor}"
                                              HorizontalContentAlignment="Stretch">

                                        <ListView.View>
                                            <GridView>

                                                <GridViewColumn Header="Created"
                                                                Width="210"
                                                                DisplayMemberBinding="{Binding CreatedAtDisplay}"/>

                                                <GridViewColumn Header="Backup File"
                                                                Width="460"
                                                                DisplayMemberBinding="{Binding FileName}"/>

                                                <GridViewColumn Header="Size"
                                                                Width="120"
                                                                DisplayMemberBinding="{Binding SizeDisplay}"/>

                                            </GridView>
                                        </ListView.View>

                                    </ListView>

                                    <StackPanel x:Name="NoBackupsPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="No configuration backups found"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="NoBackupsText"
                                                   Text="Save your settings to create a timestamped configuration backup."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="500"
                                                   Margin="0,8,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0">

                                <Button x:Name="RestoreBackupButton"
                                        Content="Restore Selected"
                                        Width="145"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                <Button x:Name="DeleteBackupButton"
                                        Content="Delete Selected"
                                        Width="145"
                                        Height="40"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>

                <!-- SCHEDULER -->
                <TabItem>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="28">

                            <!-- Scheduler header -->
                            <StackPanel Margin="0,0,0,18">

                                <TextBlock Text="Scheduler"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Automate world saves and safe server restarts."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <!-- Auto save status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="AutoSaveStatusDot"
                                             Width="12"
                                             Height="12"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock x:Name="AutoSaveStatusTitle"
                                                   Text="Automatic saves disabled"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="AutoSaveStatusDescription"
                                                   Text="Choose an interval and click Start Auto Save."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">

                                        <TextBlock Text="NEXT SAVE"
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock x:Name="NextAutoSaveText"
                                                   Text="—"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Auto save controls -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Automatic World Saves"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Save Interval"
                                                   Margin="0,16,0,6"/>

                                        <ComboBox x:Name="AutoSaveIntervalComboBox"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="2">

                                            <ComboBoxItem Content="5 minutes"
                                                          Tag="5"/>

                                            <ComboBoxItem Content="10 minutes"
                                                          Tag="10"/>

                                            <ComboBoxItem Content="15 minutes"
                                                          Tag="15"/>

                                            <ComboBoxItem Content="30 minutes"
                                                          Tag="30"/>

                                            <ComboBoxItem Content="60 minutes"
                                                          Tag="60"/>

                                        </ComboBox>

                                        <TextBlock Text="Automatic saves use Palworld's REST API and are only attempted while the server is running."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,0,0">

                                        <Button x:Name="StartAutoSaveButton"
                                                Content="Start Auto Save"
                                                Width="145"
                                                Height="42"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="StopAutoSaveButton"
                                                Content="Stop Auto Save"
                                                Width="145"
                                                Height="42"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Restart status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="RestartScheduleStatusDot"
                                             Width="12"
                                             Height="12"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock x:Name="RestartScheduleStatusTitle"
                                                   Text="Scheduled restarts disabled"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="RestartScheduleStatusDescription"
                                                   Text="Choose a restart schedule and click Start Restart Schedule."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">

                                        <TextBlock Text="NEXT RESTART"
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock x:Name="NextRestartText"
                                                   Text="—"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Restart controls -->
                            <Border Style="{StaticResource CardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Scheduled Restarts"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Restart Schedule"
                                                   Margin="0,16,0,6"/>

                                        <ComboBox x:Name="RestartScheduleComboBox"
                                                  Width="260"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="1">

                                            <ComboBoxItem Content="5 minutes (test)"
                                                          Tag="5"/>

                                            <ComboBoxItem Content="Every 6 hours"
                                                          Tag="360"/>

                                            <ComboBoxItem Content="Every 12 hours"
                                                          Tag="720"/>

                                            <ComboBoxItem Content="Every 24 hours"
                                                          Tag="1440"/>

                                            <ComboBoxItem Content="Daily at specific time"
                                                          Tag="daily"/>

                                        </ComboBox>

                                        <TextBlock Text="Daily Restart Time (24-hour HH:mm)"
                                                   Margin="0,14,0,6"/>

                                        <TextBox x:Name="DailyRestartTimeTextBox"
                                                 Width="140"
                                                 HorizontalAlignment="Left"
                                                 Text="04:00"
                                                 IsEnabled="False"/>

                                        <TextBlock Text="Players receive warnings at 10 minutes, 5 minutes, 1 minute, and 10 seconds before restart when enough time remains. The world is saved before a graceful REST API shutdown."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="650"
                                                   Margin="0,12,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,0,0">

                                        <Button x:Name="StartRestartScheduleButton"
                                                Content="Start Restart Schedule"
                                                Width="175"
                                                Height="42"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="CancelRestartScheduleButton"
                                                Content="Cancel Schedule"
                                                Width="150"
                                                Height="42"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- Scheduled configuration backup status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,18,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="ScheduledBackupStatusDot"
                                             Width="12"
                                             Height="12"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock x:Name="ScheduledBackupStatusTitle"
                                                   Text="Scheduled configuration backups disabled"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="ScheduledBackupStatusDescription"
                                                   Text="Choose an interval and click Start Backup Schedule."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">

                                        <TextBlock Text="NEXT BACKUP"
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock x:Name="NextScheduledBackupText"
                                                   Text="—"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Scheduled configuration backup controls -->
                            <Border Style="{StaticResource CardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Scheduled Configuration Backups"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Backup Interval"
                                                   Margin="0,16,0,6"/>

                                        <ComboBox x:Name="ScheduledBackupIntervalComboBox"
                                                  Width="240"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="2">

                                            <ComboBoxItem Content="15 minutes"
                                                          Tag="15"/>

                                            <ComboBoxItem Content="30 minutes"
                                                          Tag="30"/>

                                            <ComboBoxItem Content="60 minutes"
                                                          Tag="60"/>

                                            <ComboBoxItem Content="Every 6 hours"
                                                          Tag="360"/>

                                            <ComboBoxItem Content="Every 12 hours"
                                                          Tag="720"/>

                                            <ComboBoxItem Content="Every 24 hours"
                                                          Tag="1440"/>

                                        </ComboBox>

                                        <TextBlock Text="Creates a timestamped backup of the currently loaded PalWorldSettings.ini. These backups appear on the Backups page."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="650"
                                                   Margin="0,12,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,0,0">

                                        <Button x:Name="StartScheduledBackupButton"
                                                Content="Start Backup Schedule"
                                                Width="175"
                                                Height="42"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="StopScheduledBackupButton"
                                                Content="Stop Backup Schedule"
                                                Width="175"
                                                Height="42"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- Scheduled world backup status -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,18,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="ScheduledWorldBackupStatusDot"
                                             Width="12"
                                             Height="12"
                                             Fill="{StaticResource WarningColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock x:Name="ScheduledWorldBackupStatusTitle"
                                                   Text="Scheduled world backups disabled"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="ScheduledWorldBackupStatusDescription"
                                                   Text="Choose an interval and click Start World Backup Schedule."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">

                                        <TextBlock Text="NEXT WORLD BACKUP"
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock x:Name="NextScheduledWorldBackupText"
                                                   Text="—"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Scheduled world backup controls -->
                            <Border Style="{StaticResource CardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Scheduled Full World Backups"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Backup Interval"
                                                   Margin="0,16,0,6"/>

                                        <ComboBox x:Name="ScheduledWorldBackupIntervalComboBox"
                                                  Width="250"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="2">

                                            <ComboBoxItem Content="30 minutes"
                                                          Tag="30"/>

                                            <ComboBoxItem Content="60 minutes"
                                                          Tag="60"/>

                                            <ComboBoxItem Content="Every 3 hours"
                                                          Tag="180"/>

                                            <ComboBoxItem Content="Every 6 hours"
                                                          Tag="360"/>

                                            <ComboBoxItem Content="Every 12 hours"
                                                          Tag="720"/>

                                            <ComboBoxItem Content="Every 24 hours"
                                                          Tag="1440"/>

                                        </ComboBox>

                                        <TextBlock Text="While PalServer is running, the manager first requests a REST API world save, waits briefly for disk writes, then creates a compressed ZIP of the complete active world save folder."
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="700"
                                                   Margin="0,12,0,0"/>

                                        <CheckBox x:Name="EnableWorldBackupRetentionCheckBox"
                                                  Content="Automatically delete older world backups"
                                                  IsChecked="True"
                                                  Margin="0,18,0,0"/>

                                        <TextBlock Text="Keep Most Recent"
                                                   Margin="0,12,0,6"/>

                                        <ComboBox x:Name="WorldBackupRetentionComboBox"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  SelectedIndex="1">

                                            <ComboBoxItem Content="10 backups"
                                                          Tag="10"/>

                                            <ComboBoxItem Content="25 backups"
                                                          Tag="25"/>

                                            <ComboBoxItem Content="50 backups"
                                                          Tag="50"/>

                                            <ComboBoxItem Content="100 backups"
                                                          Tag="100"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,0,0">

                                        <Button x:Name="StartScheduledWorldBackupButton"
                                                Content="Start World Backup Schedule"
                                                Width="205"
                                                Height="42"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource PrimaryButtonStyle}"/>

                                        <Button x:Name="StopScheduledWorldBackupButton"
                                                Content="Stop World Backup Schedule"
                                                Width="205"
                                                Height="42"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>
                </TabItem>

                <!-- MODS -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Mods"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Manage installed Palworld server PAK mods."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <WrapPanel Grid.Column="1"
                                       VerticalAlignment="Center">

                                <Button x:Name="InstallModButton"
                                        Content="Install .PAK"
                                        Width="115"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                <Button x:Name="RefreshModsButton"
                                        Content="Refresh"
                                        Width="95"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button x:Name="OpenModsFolderButton"
                                        Content="Open Mods Folder"
                                        Width="145"
                                        Height="40"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                            </WrapPanel>

                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="ModsStatusDot"
                                         Width="12"
                                         Height="12"
                                         Fill="{StaticResource WarningColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1">

                                    <TextBlock x:Name="ModsStatusTitle"
                                               Text="Mods not loaded"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="ModsStatusDescription"
                                               Text="Select PalServer.exe on the Dashboard to locate the server's Paks folder."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <TextBlock x:Name="ModsCountText"
                                           Grid.Column="2"
                                           Text="—"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>

                            </Grid>

                        </Border>

                        <Border Grid.Row="2"
                                Background="#CC08111F"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">

                            <Grid>

                                <ListView x:Name="ModsListView"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{StaticResource TextColor}"
                                          HorizontalContentAlignment="Stretch">

                                    <ListView.View>
                                        <GridView>

                                            <GridViewColumn Header="Mod"
                                                            Width="300"
                                                            DisplayMemberBinding="{Binding DisplayName}"/>

                                            <GridViewColumn Header="Status"
                                                            Width="110"
                                                            DisplayMemberBinding="{Binding StatusDisplay}"/>

                                            <GridViewColumn Header="Size"
                                                            Width="110"
                                                            DisplayMemberBinding="{Binding SizeDisplay}"/>

                                            <GridViewColumn Header="Modified"
                                                            Width="190"
                                                            DisplayMemberBinding="{Binding LastModifiedDisplay}"/>

                                            <GridViewColumn Header="File"
                                                            Width="300"
                                                            DisplayMemberBinding="{Binding FileName}"/>

                                        </GridView>
                                    </ListView.View>

                                </ListView>

                                <StackPanel x:Name="NoModsPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="No PAK mods found"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="NoModsText"
                                               Text="PAK mods placed in the server's Pal\Content\Paks folder will appear here."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="520"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <Border Grid.Row="3"
                                Style="{StaticResource CardStyle}"
                                Margin="0,14,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Mod Controls"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="SelectedModText"
                                               Text="Select a mod above to enable or disable it."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="PalServer must be stopped before a mod can be enabled or disabled."
                                               Foreground="{StaticResource MutedTextColor}"
                                               FontSize="12"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0">

                                    <Button x:Name="EnableModButton"
                                            Content="Enable Mod"
                                            Width="120"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button x:Name="DisableModButton"
                                            Content="Disable Mod"
                                            Width="120"
                                            Height="40"
                                            Margin="0,0,10,0"
                                            IsEnabled="False"
                                            Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button x:Name="RemoveModButton"
                                            Content="Remove Mod"
                                            Width="120"
                                            Height="40"
                                            IsEnabled="False"
                                            Style="{StaticResource SecondaryButtonStyle}"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>
                </TabItem>


            </TabControl>

        </Grid>

    </Grid>

</Window>