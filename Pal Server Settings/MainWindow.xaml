<Window x:Class="PalWorldServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalWorld Server Manager"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground" Color="#0B1220"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#111827"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#172033"/>
        <SolidColorBrush x:Key="InputBackground" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="MutedTextColor" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource InputBackground}"/>
        </Style>

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextColor}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

            <Setter Property="Margin"
                    Value="10,3"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#1E293B"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource PanelBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderColor}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#0F172A"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        Margin="15">

                    <StackPanel>
                        <TextBlock Text="PalWorld Server Manager"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Version 0.2 UI Preview"
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,20">

                    <TextBlock Text="PALWORLD"
                               Foreground="#60A5FA"
                               FontSize="13"
                               FontWeight="Bold"/>

                    <TextBlock Text="Server Manager"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Dedicated Server Tools"
                               Foreground="{StaticResource MutedTextColor}"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel>

                    <Button Content="Dashboard"
                            Tag="0"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="Settings"
                            Tag="1"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="Players"
                            Tag="2"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="Console"
                            Tag="3"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="Backups"
                            Tag="4"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="Scheduler"
                            Tag="5"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                    <Button Content="Mods"
                            Tag="6"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="NavigationButton_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main page area -->
        <Grid Grid.Column="1"
              Background="{StaticResource WindowBackground}">

            <TabControl x:Name="MainNavigationTabControl"
                        SelectedIndex="0"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- Hide normal tab headers -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Dashboard -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="30">

                            <Grid Margin="0,0,0,22">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Dashboard"
                                               FontSize="29"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Overview of the currently loaded server configuration."
                                               Foreground="{StaticResource MutedTextColor}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Open Settings"
                                        Width="140"
                                        Height="42"
                                        Tag="1"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="NavigationButton_Click"/>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <StackPanel>
                                    <TextBlock Text="Welcome to PalWorld Server Manager"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Your working settings editor is available from the Settings page. Dashboard information and server controls will be connected in the next step."
                                               Foreground="{StaticResource MutedTextColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">

                                    <StackPanel>
                                        <TextBlock Text="Settings Editor"
                                                   Foreground="{StaticResource MutedTextColor}"/>

                                        <TextBlock Text="Ready"
                                                   Foreground="{StaticResource SuccessColor}"
                                                   FontSize="23"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,12,0">

                                    <StackPanel>
                                        <TextBlock Text="Automatic Backups"
                                                   Foreground="{StaticResource MutedTextColor}"/>

                                        <TextBlock Text="Enabled"
                                                   Foreground="{StaticResource SuccessColor}"
                                                   FontSize="23"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}">

                                    <StackPanel>
                                        <TextBlock Text="Current Branch"
                                                   Foreground="{StaticResource MutedTextColor}"/>

                                        <TextBlock Text="ui-redesign"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>
                </TabItem>

                <!-- Settings -->
                <TabItem>

                    <Grid Margin="28">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Server Settings"
                                           FontSize="29"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Load, edit, validate, and save PalWorldSettings.ini."
                                           Foreground="{StaticResource MutedTextColor}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <Button Content="Load Settings"
                                        Width="135"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LoadButton_Click"/>

                                <Button x:Name="SaveButton"
                                        Content="Save Settings"
                                        Width="135"
                                        Height="40"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <TabControl Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderColor}">

                            <TabItem Header="Server">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Server Information"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Server Name"/>
                                            <TextBox x:Name="ServerNameTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Server Description"/>
                                            <TextBox x:Name="DescriptionTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Players"/>
                                            <TextBox x:Name="MaxPlayersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Admin Password"/>
                                            <PasswordBox x:Name="AdminPasswordBox"
                                                         Margin="0,6,0,16"/>

                                            <TextBlock Text="Server Password"/>
                                            <PasswordBox x:Name="ServerPasswordBox"
                                                         Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Gameplay">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Gameplay Rates"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="XP Rate"/>
                                            <TextBox x:Name="ExpRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Pal Capture Rate"/>
                                            <TextBox x:Name="PalCaptureRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Pal Spawn Rate"/>
                                            <TextBox x:Name="PalSpawnRateTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Daytime Speed Rate"/>
                                            <TextBox x:Name="DayTimeSpeedTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Nighttime Speed Rate"/>
                                            <TextBox x:Name="NightTimeSpeedTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Work Speed Rate"/>
                                            <TextBox x:Name="WorkSpeedTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="PvP &amp; Hardcore">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="PvP and Hardcore"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <CheckBox x:Name="PvpCheckBox"
                                                      Content="Enable PvP"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="HardcoreCheckBox"
                                                      Content="Enable Hardcore Mode"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="FriendlyFireCheckBox"
                                                      Content="Enable Friendly Fire"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="CharacterRecreateCheckBox"
                                                      Content="Allow Character Recreation in Hardcore"
                                                      Margin="0,5,0,18"/>

                                            <TextBlock Text="Death Penalty"/>

                                            <ComboBox x:Name="DeathPenaltyComboBox"
                                                      IsEditable="True"
                                                      Margin="0,6,0,0">

                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Item"/>
                                                <ComboBoxItem Content="ItemAndEquipment"/>
                                                <ComboBoxItem Content="All"/>

                                            </ComboBox>

                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Bases &amp; Guilds">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Bases and Guilds"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Workers Per Base"/>
                                            <TextBox x:Name="BaseWorkersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Guild Players"/>
                                            <TextBox x:Name="GuildPlayersTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Bases Per Guild"/>
                                            <TextBox x:Name="BasesPerGuildTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Maximum Total Base Camps"/>
                                            <TextBox x:Name="BaseCampMaxTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Network">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Network Settings"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <TextBlock Text="Public IP Address"/>
                                            <TextBox x:Name="PublicIpTextBox"
                                                     Margin="0,6,0,16"/>

                                            <TextBlock Text="Public Port"/>
                                            <TextBox x:Name="PublicPortTextBox"
                                                     Margin="0,6,0,16"/>

                                            <CheckBox x:Name="RconEnabledCheckBox"
                                                      Content="Enable RCON"
                                                      Margin="0,5,0,16"/>

                                            <TextBlock Text="RCON Port"/>
                                            <TextBox x:Name="RconPortTextBox"
                                                     Margin="0,6,0,16"/>

                                            <CheckBox x:Name="RestApiEnabledCheckBox"
                                                      Content="Enable REST API"
                                                      Margin="0,5,0,16"/>

                                            <TextBlock Text="REST API Port"/>
                                            <TextBox x:Name="RestApiPortTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Advanced">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="15">

                                        <StackPanel>

                                            <TextBlock Text="Advanced Settings"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,20"/>

                                            <CheckBox x:Name="UseAuthCheckBox"
                                                      Content="Require Authentication"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="AllowClientModCheckBox"
                                                      Content="Allow Client Mods"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="BackupSaveDataCheckBox"
                                                      Content="Use Backup Save Data"
                                                      Margin="0,5,0,16"/>

                                            <CheckBox x:Name="ShowPlayerListCheckBox"
                                                      Content="Show Player List"
                                                      Margin="0,5,0,18"/>

                                            <TextBlock Text="Maximum Chat Posts Per Minute"/>
                                            <TextBox x:Name="ChatPostLimitTextBox"
                                                     Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>

                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10"
                                Margin="0,15,0,0">

                            <TextBlock x:Name="StatusTextBlock"
                                       Text="No settings file loaded."
                                       Foreground="{StaticResource MutedTextColor}"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid>
                        <TextBlock Text="Players will be added in a future phase."
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid>
                        <TextBlock Text="The live server console will be added later."
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid>
                        <TextBlock Text="Backup management will be added here."
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid>
                        <TextBlock Text="Scheduled restarts and backups will be added here."
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid>
                        <TextBlock Text="Mod management is planned for a future release."
                                   Foreground="{StaticResource MutedTextColor}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

            </TabControl>

        </Grid>

    </Grid>

</Window>